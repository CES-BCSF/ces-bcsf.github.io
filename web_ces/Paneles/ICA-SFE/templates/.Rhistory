hp_sfe.rtt_trend <- hp_sfe.rtt_trend[,1] # PASA DE MULTIVARIADA A UNIVARIADA
# AGREGO NAS HASTA EL FINAL DEL PERIODO
targuet <- length(sfe.rtt)
ltrend <- length(hp_sfe.rtt_trend)
hp_sfe.rtt_trend <- rbind(as.matrix(hp_sfe.rtt_trend),
as.matrix(rep(NA, (targuet-ltrend))))
o_sfe.rtt_hp_129600 <- ts(hp_sfe.rtt_trend, frequency=12, start=c(1992,1), end=c(2030,12))
o_sfe.rtt_hp_129600 <- o_sfe.rtt_hp_129600[,1]
# BORRO OBJETOS TEMPORALES
rm (hp_sfe.rtt_129600, hp_sfe.rtt_trend, targuet, ltrend)
## SFE-VIPA ####
## INPUT
input_data_4 <- read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Ventas/SFE_VS.xlsx",
sheet = "OUTM",
range = "B10:B453",
col_names = FALSE) %>%
rename("transformada" = 1) # rename() FUNCION DE tidyverse
sfe.vipa <- ts(input_data_4$transformada, frequency=12, start=c(1994,1))
rm(input_data_4)
## FILTROS HP
hp_sfe.vipa_129600 <- hpfilter(na.omit(sfe.vipa), freq = 129600,
type = "lambda") # CALCULA FILTRO
hp_sfe.vipa_trend <- hp_sfe.vipa_129600$trend # CREA OBJETO CON LA TENDENCIA
hp_sfe.vipa_trend <- hp_sfe.vipa_trend[,1] # PASA DE MULTIVARIADA A UNIVARIADA
# AGREGO NAS HASTA EL FINAL DEL PERIODO
targuet <- length(sfe.vipa)
ltrend <- length(hp_sfe.vipa_trend)
hp_sfe.vipa_trend <- rbind(as.matrix(hp_sfe.vipa_trend),
as.matrix(rep(NA, (targuet-ltrend))))
p_sfe.vipa_hp_129600 <- ts(hp_sfe.vipa_trend, frequency=12, start=c(1994,1), end=c(2030,12))
p_sfe.vipa_hp_129600 <- p_sfe.vipa_hp_129600[,1]
# BORRO OBJETOS TEMPORALES
rm (hp_sfe.vipa_129600, hp_sfe.vipa_trend, targuet, ltrend)
# PLOTS ####
