# ELIMINO SERIES EN NIVELES
rm(arg.emae, arg.iga, ica.sfe, icasfent, icei, icei.sym, iceint, sfe.cem, sfe.exe, sfe.ind, sfe.ntta, sfe.rem, sfe.rgvn, sfe.rtt, sfe.vipa, ica.arg)
# ANALISIS DE LONGITUD
l_emae <- length(b_arg.emae_hp_129600)
l_iga <- length(c_arg.iga_hp_129600)
l_ica.sfe <- length(d_ica.sfe_hp_129600)
l_icasfent <- length(e_icasfent_hp_129600)
l_iceisym <- length(f_icei.sym_hp_129600)
l_icei <- length(g_icei_hp_129600)
l_iceint <- length(h_iceint_hp_129600)
l_cem <- length(i_sfe.cem_hp_129600)
l_exe <- length(j_sfe.exe_hp_129600)
l_ind <- length(k_sfe.ind_hp_129600)
l_ntta <- length(l_sfe.ntta_hp_129600)
l_rem <- length(m_sfe.rem_hp_129600)
l_rgvn <- length(n_sfe.rgvn_hp_129600)
l_rtt <- length(o_sfe.rtt_hp_129600)
l_vipa <- length(p_sfe.vipa_hp_129600)
l_icaarg <- length(q_ica.arg_hp_129600)
# PARA EL CASO DE SERIES ESPECIFICAS CORTAS
# SE AGREGAN NAS AL COMIENZO PARA QUE COMIENCEN EN EL MISMO MOMENTO QUE LA SERIE MAS LARGA
# SE COMPARAN CONTRA rtt QUE ES LA SERIE MAS LARGA
if (l_rtt >= l_rem)
{m_sfe.rem_hp_129600 <- ts(c(rep(NA, l_rtt-l_rem), m_sfe.rem_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_cem)
{i_sfe.cem_hp_129600 <- ts(c(rep(NA, l_rtt-l_cem), i_sfe.cem_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_exe)
{j_sfe.exe_hp_129600 <- ts(c(rep(NA, l_rtt-l_exe), j_sfe.exe_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_vipa)
{p_sfe.vipa_hp_129600 <- ts(c(rep(NA, l_rtt-l_vipa), p_sfe.vipa_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_ntta)
{l_sfe.ntta_hp_129600 <- ts(c(rep(NA, l_rtt-l_ntta), l_sfe.ntta_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_ind)
{k_sfe.ind_hp_129600 <- ts(c(rep(NA, l_rtt-l_ind), k_sfe.ind_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_rgvn)
{n_sfe.rgvn_hp_129600 <- ts(c(rep(NA, l_rtt-l_rgvn), n_sfe.rgvn_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_emae)
{b_arg.emae_hp_129600 <- ts(c(rep(NA, l_rtt-l_emae), b_arg.emae_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_iga)
{c_arg.iga_hp_129600 <- ts(c(rep(NA, l_rtt-l_iga), c_arg.iga_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_iceint)
{h_iceint_hp_129600 <- ts(c(rep(NA, l_rtt-l_iceint), h_iceint_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_icei)
{g_icei_hp_129600 <- ts(c(rep(NA, l_rtt-l_icei), g_icei_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_iceisym)
{f_icei.sym_hp_129600 <- ts(c(rep(NA, l_rtt-l_iceisym), f_icei.sym_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_ica.sfe)
{d_ica.sfe_hp_129600 <- ts(c(rep(NA, l_rtt-l_ica.sfe), d_ica.sfe_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_icasfent)
{e_icasfent_hp_129600 <- ts(c(rep(NA, l_rtt-l_icasfent), e_icasfent_hp_129600), start = c(1992, 1), frequency = 12)}
if (l_rtt >= l_icaarg)
{q_ica.arg_hp_129600 <- ts(c(rep(NA, l_rtt-l_icasfent), q_ica.arg_hp_129600), start = c(1992, 1), frequency = 12)}
# ELIMINO LOS ELEMENTOS Y SERIES QUE SOBRAN
rm(l_cem, l_exe, l_emae, l_ica.sfe, l_icasfent, l_iga, l_icei, l_iceint, l_iceisym,
l_ind, l_ntta, l_rem, l_rgvn, l_rtt, l_vipa, l_icaarg)
# CREA OBJETO VECTOR DE TIPO CARACTERES CON TODOS LOS OBJETOS DEL ENVIRONMENT (E)
var_names <- ls()
# LONGITUD DEL VECTOR
len_max <- length(var_names)
# CREA OBJETO TS CON LAS SERIES A EXPORTAR
series_list <- list()
# LOOP QUE ALMACENA DENTRO DE LA LISTA CADA SERIE DESEADA
for (i in 1:len_max) {
series_list[[i]] <- get(var_names[i])
}
# SE RECOPILA LA LONGITUD DE LA SERIE MAS LARGA
max_len <- max(sapply(series_list, length))
# LOOP PARA QUE TODAS LAS SERIES TENGAN LA MISMA LONGITUD (CONDICION PARA INCORPORARSE AL DATA.FRAME)
for(i in 1:len_max){
if(length(series_list[[i]])!=max_len){
series_list[[i]]  <- c(series_list[[i]], rep(NA, max_len-length(series_list[[i]])))
}
}
# SE CREA DATA.FRAME VACIO CON FILAS Y COLUMNAS ASOCIADAS A LA LONGITUD Y SERIES DESEADAS
df <- data.frame(matrix(NA, nrow = max_len, ncol = length(series_list)))
# SE COMPLETA EL DATA.FRAME CON SERIES DESEADAS
for (i in 1:len_max) {
df[,i] <- as.numeric(series_list[[i]])
}
# SE ASIGNA NOMBRES A LAS SERIES EN SINTONIA CON LOS NOMBRES PREVIOS
names(df) <- var_names
# CREA VARIABLE TIPO FECHA
fecha <- seq(as.Date("1992-01-01"), as.Date("2030-12-01"), by = "month")
fecha <- format(fecha, "%Y.%m") # SE ASIGNA FORMATO
# SE UNE EL DATA.FRAME CON SERIES JUNTO CON LA VARIABLE FECHA
data <- cbind(fecha,df)
#SI SE ACTIVA, REEMPLAZA LOS ESPACIOS VACIOS POR NAS
#data <- replace(data, is.na(data), "#N/A")
data_exportar <- list('Data' = data)
# SE EXPORTA EL DATA.FRAME A UN EXCEL
openxlsx::write.xlsx(data_exportar, "C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Output_R/HP_mensuales_out.xlsx")
#BORRA OBJETOS TEMPORALES
rm(i, len_max, max_len, var_names, df, data, fecha, series_list, data_exportar)
