}
# SE ASIGNA NOMBRES A LAS SERIES EN SINTONIA CON LOS NOMBRES PREVIOS
names(df) <- var_names
# CREA VARIABLE TIPO FECHA
#fecha <- seq(as.Date("1970-01-01"), as.Date("2030-12-01"), by = "quarter")
#fecha <- format(fecha, "%Y.%m") # SE ASIGNA FORMATO
fecha <- seq(as.Date("1970-01-01"), as.Date("2030-12-01"), by = "quarter")
anio <- format(fecha, "%Y")
trim <- paste0("Q", quarter(fecha))
fecha <- paste(anio, trim, sep = ".")
# SE UNE EL DATA.FRAME CON SERIES JUNTO CON LA VARIABLE FECHA
data <- cbind(fecha,df)
#SI SE ACTIVA, REEMPLAZA LOS ESPACIOS VACIOS POR NAS
#data <- replace(data, is.na(data), "#N/A")
data_exportar <- list('Data' = data)
# SE EXPORTA EL DATA.FRAME A UN EXCEL
openxlsx::write.xlsx(data_exportar, "C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Output_R/HP_trimestres_out.xlsx")
#BORRA OBJETOS TEMPORALES
rm(i, len_max, max_len, var_names, df, data, fecha, anio, trim, series_list, data_exportar)
# << DATOS BASICOS  >> ####
# ARCHIVO PARA CALCULAR TENDENCIAS DE SERIES POR MEDIO DE FILTROS HP
# VERSION: 1.3 ####
# PRIMERA VERSION DEL 11-07-2023
# SEGUNDA VERSION DEL 23-01-2024
# TERCERA VERSION DEL 16-08-2024 | AHORA SE ORDENAN LAS SALIDAS CON UNA LETRA DEFINIDA POR EL USUARIO
# PAQUETES ####
library(readxl)
library(tidyverse)
library(mFilter)
# SERIES CONSIDERADAS ####
rm(list = ls())
graphics.off()
# FILTROS HP
# LAMBDA = 1600 EN SERIES TRIMESTRALES
# LAMBDA = 129600  EN SERIES MENSUALES | EL SOFTWARE SUGIERE 14400 (RESALTA GIROS)
# type = "frequency" HACE QUE LA FUNCION ELIJA UN LAMBDA ACORDE A LA SERIE EN FORMA AUTOMATICA
# type = "lambda" HACE QUE freq SEA PARA DEFINIR MANUALMENTE LAMBDA, EJ. FREQ = 1600)
## ARG-EMAE ####
## INPUT
input_data_14 <- read_excel("C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/IndComp/ARG_ciclos.xlsx",
sheet = "OUTM",
range = "B10:B465",
col_names = FALSE) %>%
rename("transformada" = 1) # rename() FUNCION DE tidyverse
arg.emae <- ts(input_data_14$transformada, frequency=12, start=c(1993,1))
rm(input_data_14)
## FILTROS HP
hp_arg.emae_129600 <- hpfilter(na.omit(arg.emae), freq = 129600,
type = "lambda") # CALCULA FILTRO
hp_arg.emae_trend <- hp_arg.emae_129600$trend # CREA OBJETO CON LA TENDENCIA
hp_arg.emae_trend <- hp_arg.emae_trend[,1] # PASA DE MULTIVARIADA A UNIVARIADA
# AGREGO NAS HASTA EL FINAL DEL PERIODO
targuet <- length(arg.emae)
ltrend <- length(hp_arg.emae_trend)
hp_arg.emae_trend <- rbind(as.matrix(hp_arg.emae_trend),
as.matrix(rep(NA, (targuet-ltrend))))
b_arg.emae_hp_129600 <- ts(hp_arg.emae_trend, frequency=12, start=c(1993,1), end=c(2030,12))
b_arg.emae_hp_129600 <- b_arg.emae_hp_129600[,1]
# BORRO OBJETOS TEMPORALES
rm (hp_arg.emae_129600, hp_arg.emae_trend, targuet, ltrend)
