# ENVIA UNA COPIA DEL ARCHIVO DESDE LA CARPETA LOCAL A CARPETA DE PRECIOS ####
archivo <- "RA_MA.html"
carpeta_origen <- "C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/_Reportes rmd/RA/Margenes_agropecuarios"
carpeta_destino <- "C:/mysyncfolders/bcsf.com.ar/BCSF - Grupo CES - Documentos/CicSFE_sp/Agro"
